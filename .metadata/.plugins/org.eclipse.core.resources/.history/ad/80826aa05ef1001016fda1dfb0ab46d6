void SD_wlog(char* mess){
	RTC_TimeTypeDef sTime;
	RTC_DateTypeDef sDate;

	HAL_RTC_GetTime(&hrtc, &sTime, RTC_FORMAT_BIN);
	HAL_RTC_GetDate(&hrtc, &sDate, RTC_FORMAT_BIN); //get actual RTC date&time

	char final_txt[128];
	sprintf(final_txt, "%02d.%02d.20%02d %02d:%02d:%02d - %s\n", sDate.Date, sDate.Month, sDate.Year,
			sTime.Hours, sTime.Minutes, sTime.Seconds, mess);

	fres = f_mount(&fs, "", 1);
	if (fres == FR_OK) {
		fres = f_open(&fil, "log.txt", FA_WRITE | FA_OPEN_ALWAYS | FA_OPEN_APPEND);
		if (fres == FR_OK) {
			f_puts(final_txt, &fil);

			f_close(&fil);
		}
	}

	f_mount(NULL, "", 0);
}
