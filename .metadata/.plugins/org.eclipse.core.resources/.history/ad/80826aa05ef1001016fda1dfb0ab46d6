  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	  if (G_OPEN == 1) {
		  G_OPEN = 0; //flag to open gate, reset it to 0

		  char msg[60];
		  if (OPEN_SOURCE == 1) {
			  //manually opened
			  if (CAR_IN == 1 && CAR_OUT == 0) {
				  //opened from the inside, car going out
				  sprintf(msg, "VYJAZD z garaze");
				  SD_wlog(msg);
			  }
			  else {
				  sprintf(msg, "BLOKOVANIE garaze");
				  SD_wlog(msg);
			  }
		  }
		  else if (OPEN_SOURCE == 0) {
			  //automatically opened
			  if (CAR_IN == 0 && CAR_OUT == 1) {
				  //opened from the outside, car going in
				  sprintf(msg, "VJAZD do garaze povoleny");
				  SD_wlog(msg);
			  }
			  else {
				  sprintf(msg, "BLOKOVANIE garaze");
				  SD_wlog(msg);
			  }

		  }
	  }
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

